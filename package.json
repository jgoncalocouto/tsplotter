{
  "name": "tsplotter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "npm run prepare:assets && vite build --base=./",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:reference": "node tests/browser-reference-parquet.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.30.0",
    "plotly.js-dist-min": "3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "h5wasm": "0.10.3"
  },
  "devDependencies": {"vite": "7.3.1", "@playwright/test": "1.65.1"}
}
